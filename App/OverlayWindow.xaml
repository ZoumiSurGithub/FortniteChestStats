<Window x:Class="FortniteChestCounter.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FortniteChestCounter"
        Title="Fortnite Overlay"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" Left="24" Top="24"
        FontFamily="Segoe UI Variable Display, Segoe UI">

    <!-- Carte arrondie, verre sombre doux -->
    <Border Margin="0,0,14,14" Padding="20,16,20,16" CornerRadius="24" Background="#E0201D45" MinWidth="262">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.35"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="{local:L Fr='Dernière partie', En='Last game', Es='Última partida'}" Foreground="#B9B6EE" FontSize="13" FontWeight="SemiBold"/>

            <TextBlock x:Name="EmptyText" Text="{local:L Fr='En attente de la fin de votre partie…', En='Waiting for your game to end…', Es='Esperando el final de tu partida…'}" Foreground="White"
                       FontSize="15" TextWrapping="Wrap" MaxWidth="220" Margin="0,8,0,4"/>

            <StackPanel x:Name="DataPanel" Visibility="Collapsed">
                <!-- Total fouillé en grand -->
                <StackPanel Orientation="Horizontal" Margin="0,6,0,6">
                    <Border Width="44" Height="44" CornerRadius="22" Background="#33F2B84B" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Image x:Name="IcoTotal" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TotalText" Text="0" Foreground="White" FontSize="46" FontWeight="SemiBold" Margin="0,-6,0,-6"/>
                        <TextBlock Text="{local:L Fr='fouillés au total', En='searched in total', Es='buscados en total'}" Foreground="#B9B6EE" FontSize="12"/>
                    </StackPanel>
                </StackPanel>

                <Rectangle Height="1" Fill="#26FFFFFF" Margin="0,8,0,6"/>
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="15" Background="#33F2B84B" Margin="0,0,10,0">
                        <Image x:Name="IcoChests" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="{local:L Fr='Coffres', En='Chests', Es='Cofres'}" Foreground="#D8D6F5" FontSize="15" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ChestsText" Grid.Column="2" Text="0" Foreground="White" FontSize="21" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="24,0,0,0"/>
                </Grid>
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="15" Background="#335AA9F0" Margin="0,0,10,0">
                        <Image x:Name="IcoAmmo" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="{local:L Fr='Munitions', En='Ammo', Es='Munición'}" Foreground="#D8D6F5" FontSize="15" VerticalAlignment="Center"/>
                    <TextBlock x:Name="AmmoText" Grid.Column="2" Text="0" Foreground="White" FontSize="21" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="24,0,0,0"/>
                </Grid>
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="15" Background="#339B7BFF" Margin="0,0,10,0">
                        <Image x:Name="IcoOther" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="{local:L Fr='Autres', En='Others', Es='Otros'}" Foreground="#D8D6F5" FontSize="15" VerticalAlignment="Center"/>
                    <TextBlock x:Name="OtherText" Grid.Column="2" Text="0" Foreground="White" FontSize="21" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="24,0,0,0"/>
                </Grid>

                <Rectangle Height="1" Fill="#26FFFFFF" Margin="0,8,0,6"/>
                <Grid x:Name="PlaceRow" Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="15" Background="#339B7BFF" Margin="0,0,10,0">
                        <Image x:Name="IcoPlace" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="{local:L Fr='Classement', En='Placement', Es='Clasificación'}" Foreground="#D8D6F5" FontSize="15" VerticalAlignment="Center"/>
                    <TextBlock x:Name="PlaceText" Grid.Column="2" Text="" Foreground="White" FontSize="21" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="24,0,0,0"/>
                </Grid>
                <Grid x:Name="ElimRow" Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="15" Background="#33FF7A90" Margin="0,0,10,0">
                        <Image x:Name="IcoElim" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="{local:L Fr='Éliminations', En='Eliminations', Es='Eliminaciones'}" Foreground="#D8D6F5" FontSize="15" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ElimText" Grid.Column="2" Text="" Foreground="White" FontSize="21" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="24,0,0,0"/>
                </Grid>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
