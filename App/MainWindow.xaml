<Window x:Class="FortniteChestCounter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FortniteChestCounter"
        Title="Fortnite Stats" Icon="app.ico" Width="920" Height="820" MinWidth="720" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        FontFamily="Segoe UI Variable Display, Segoe UI">

    <Window.Resources>
        <!-- Couleurs du thème (remplacées à l'exécution par le mode nuit) -->
        <LinearGradientBrush x:Key="BgBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F1ECFF" Offset="0"/>
            <GradientStop Color="#E6EEFF" Offset="0.55"/>
            <GradientStop Color="#DDF2FF" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="TextPrimary" Color="#2D2B55"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#6E6C9C"/>
        <SolidColorBrush x:Key="TextMuted" Color="#8E8CB8"/>
        <SolidColorBrush x:Key="AccentText" Color="#6B57D6"/>
        <SolidColorBrush x:Key="CardBrush" Color="#E8FFFFFF"/>
        <SolidColorBrush x:Key="RowBrush" Color="#C8FFFFFF"/>
        <SolidColorBrush x:Key="RowHoverBrush" Color="#E6FFFFFF"/>
        <SolidColorBrush x:Key="RowSelBrush" Color="#F0E9FF"/>
        <SolidColorBrush x:Key="DetailsBg" Color="#F6F3FF"/>
        <SolidColorBrush x:Key="DetailsFg" Color="#3B3966"/>
        <SolidColorBrush x:Key="SecBtnBg" Color="#EDE8FF"/>
        <local:IconConverter x:Key="IconConv"/>
        <DropShadowEffect x:Key="SoftShadow" Color="#4B3FA0" BlurRadius="26" ShadowDepth="6" Direction="270" Opacity="0.14"/>

        <LinearGradientBrush x:Key="StartBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#A58BFF" Offset="0"/>
            <GradientStop Color="#6FB1F7" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="StopBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF9AA9" Offset="0"/>
            <GradientStop Color="#FF7A90" Offset="1"/>
        </LinearGradientBrush>

        <!-- Bouton pilule -->
        <Style x:Key="SoftButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="30,11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="24"
                                Padding="{TemplateBinding Padding}" Effect="{StaticResource SoftShadow}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform x:Name="Sc" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1.05" Duration="0:0:0.14"/>
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1.05" Duration="0:0:0.14"/>
                                    </Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.14"/>
                                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.14"/>
                                    </Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Onglet (capsule) -->
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="21" Padding="22,9" Margin="1,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ligne d'historique -->
        <Style x:Key="HistoryItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="22,12,20,12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Bg" Background="{DynamicResource RowBrush}" CornerRadius="16"/>
                            <Border x:Name="Dot" Width="6" Height="22" CornerRadius="3" HorizontalAlignment="Left"
                                    Margin="9,0,0,0" Background="Transparent"/>
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource RowHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource RowSelBrush}"/>
                                <Setter TargetName="Dot" Property="Background" Value="#9B7BFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="32,26,32,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{local:L Fr='Stats de partie', En='Game stats', Es='Estadísticas de partida'}" Foreground="{DynamicResource TextPrimary}" FontSize="34" FontWeight="SemiBold"/>
                <TextBlock x:Name="StatusText" Text="{local:L Fr='Prêt. Cliquez sur « Lancer ».', En='Ready. Click “Start”.', Es='Listo. Haz clic en «Iniciar».'}" Foreground="{DynamicResource TextSecondary}"
                           FontSize="14" Margin="2,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,6,8">
                <Button x:Name="LangButton" Content="🌐" Style="{StaticResource SoftButton}"
                        Background="{DynamicResource SecBtnBg}" Foreground="{DynamicResource AccentText}"
                        FontSize="14" Padding="18,10" Margin="0,0,14,0" Click="LangButton_Click"/>
                <Button x:Name="ThemeButton" Content="{local:L Fr='☾  Mode nuit', En='☾  Night mode', Es='☾  Modo noche'}" Style="{StaticResource SoftButton}"
                        Background="{DynamicResource SecBtnBg}" Foreground="{DynamicResource AccentText}"
                        FontSize="14" Padding="20,10" Margin="0,0,14,0" Click="ThemeButton_Click"/>
                <Button x:Name="StartButton" Content="{local:L Fr='▶  Lancer', En='▶  Start', Es='▶  Iniciar'}" Style="{StaticResource SoftButton}"
                        Background="{StaticResource StartBrush}" Click="StartButton_Click"/>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="3" Margin="2,10,0,0" Foreground="{DynamicResource TextMuted}" FontSize="12" TextWrapping="Wrap"
                   Text="{local:L Fr='Lancer = surveille vos parties et affiche l\'overlay par-dessus le jeu  ·  Ctrl+F7 : masquer / afficher l\'overlay  ·  Ctrl+F8 : quitter', En='Start = watches your games and shows the overlay on top of the game  ·  Ctrl+F7: hide / show the overlay  ·  Ctrl+F8: quit', Es='Iniciar = vigila tus partidas y muestra el overlay sobre el juego  ·  Ctrl+F7: ocultar / mostrar el overlay  ·  Ctrl+F8: salir'}"/>

        <!-- Onglets -->
        <Border Grid.Row="1" HorizontalAlignment="Left" Background="{DynamicResource RowBrush}" CornerRadius="26" Padding="5"
                Margin="0,14,0,20" Effect="{StaticResource SoftShadow}">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="TabGames" Content="{local:L Fr='Parties', En='Games', Es='Partidas'}" Style="{StaticResource TabButton}" Click="TabGames_Click"/>
                <Button x:Name="TabTreasure" Content="{local:L Fr='Chasse au trésor', En='Treasure hunt', Es='Búsqueda del tesoro'}" Style="{StaticResource TabButton}" Click="TabTreasure_Click"/>
                <Button x:Name="TabAccount" Content="{local:L Fr='Mon compte', En='My account', Es='Mi cuenta'}" Style="{StaticResource TabButton}" Click="TabAccount_Click"/>
            </StackPanel>
        </Border>

        <!-- ================= Chasse au trésor ================= -->
        <ScrollViewer x:Name="TreasureScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel Margin="0,0,12,0">
                <TextBlock x:Name="TreasureTitle" Text="{local:L Fr='Chasse au trésor', En='Treasure hunt', Es='Búsqueda del tesoro'}" Foreground="{DynamicResource AccentText}"
                           FontSize="22" FontWeight="SemiBold"/>
                <TextBlock x:Name="TreasureSub" Foreground="{DynamicResource TextMuted}" FontSize="13" Margin="2,2,0,16" TextWrapping="Wrap"/>

                <TextBlock Text="{local:L Fr='Dernière partie', En='Last game', Es='Última partida'}" Foreground="{DynamicResource TextPrimary}" FontSize="16" FontWeight="SemiBold" Margin="2,0,0,10"/>
                <TextBlock x:Name="TreasureNoGame" Foreground="{DynamicResource TextSecondary}" FontSize="14" Margin="2,0,0,16" TextWrapping="Wrap"
                           Text="{local:L Fr='Aucune partie analysée pour le moment.', En='No game analysed yet.', Es='Ninguna partida analizada por ahora.'}"/>
                <ItemsControl x:Name="TreasureLast" Margin="0,0,0,6">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Loaded="Card_Loaded" MouseEnter="Card_Enter" MouseLeave="Card_Leave" Width="214" Margin="0,0,18,18" Padding="20,16,16,14" CornerRadius="24"
                                    Background="{DynamicResource CardBrush}" Effect="{StaticResource SoftShadow}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="40" Height="40" CornerRadius="20" Background="{Binding Tint, FallbackValue=#33F2B84B}">
                                            <Image Source="{Binding Key, Converter={StaticResource IconConv}}" Width="22" Height="22"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextSecondary}" FontSize="15"
                                                   FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" MaxWidth="130"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Value}" Foreground="{DynamicResource TextPrimary}" FontSize="40"
                                               FontWeight="SemiBold" Margin="2,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{local:L Fr='Depuis le début', En='Since the beginning', Es='Desde el principio'}" Foreground="{DynamicResource TextPrimary}" FontSize="16" FontWeight="SemiBold" Margin="2,4,0,10"/>
                <ItemsControl x:Name="TreasureAll" Margin="0,0,0,6">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Loaded="Card_Loaded" MouseEnter="Card_Enter" MouseLeave="Card_Leave" Width="214" Margin="0,0,18,18" Padding="20,16,16,14" CornerRadius="24"
                                    Background="{DynamicResource CardBrush}" Effect="{StaticResource SoftShadow}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="40" Height="40" CornerRadius="20" Background="{Binding Tint, FallbackValue=#33F2B84B}">
                                            <Image Source="{Binding Key, Converter={StaticResource IconConv}}" Width="22" Height="22"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextSecondary}" FontSize="15"
                                                   FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" MaxWidth="130"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Value}" Foreground="{DynamicResource TextPrimary}" FontSize="40"
                                               FontWeight="SemiBold" Margin="2,8,0,0"/>
                                    <TextBlock Text="{Binding Sub}" Foreground="{DynamicResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{local:L Fr='Récompenses', En='Rewards', Es='Recompensas'}" Foreground="{DynamicResource TextPrimary}" FontSize="16" FontWeight="SemiBold" Margin="2,10,0,4"/>
                <TextBlock x:Name="ImageHint" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="2,0,0,12" TextWrapping="Wrap"
                           Text="{local:L Fr='Cliquez sur une récompense pour la cocher (ou la décocher) si vous l\'avez déjà trouvée. Celles vues dans vos rediffusions sont cochées automatiquement. Les pourcentages sont les chances officielles par coffre ; « Votre chance » est la probabilité de l\'avoir eue au moins une fois avec les coffres que vous avez fouillés depuis le début de la semaine concernée (les Heures du trésor ne sont pas comptées). Les images se téléchargent une seule fois (connexion internet requise).', En='Click a reward to tick (or untick) it if you have already found it. Rewards seen in your replays are ticked automatically. Percentages are the official odds per chest; “Your chance” is the probability of having got it at least once with the chests you searched since the start of that week (Treasure Hours are not counted). Images are downloaded once (internet connection required).', Es='Haz clic en una recompensa para marcarla (o desmarcarla) si ya la has encontrado. Las vistas en tus repeticiones se marcan solas. Los porcentajes son las probabilidades oficiales por cofre; «Tu probabilidad» es la de haberla obtenido al menos una vez con los cofres abiertos desde el inicio de esa semana (las Horas del tesoro no cuentan). Las imágenes se descargan una sola vez (se necesita conexión a internet).'}"/>

                <ItemsControl x:Name="WeekList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource AccentText}" FontSize="15" FontWeight="SemiBold" Margin="2,0,0,2"/>
                                <TextBlock Text="{Binding Sub}" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="2,0,0,10"/>
                                <TextBlock Text="{local:L Fr='Récompenses pas encore connues.', En='Rewards not known yet.', Es='Recompensas aún desconocidas.'}" Foreground="{DynamicResource TextMuted}" FontSize="12"
                                           Margin="2,0,0,8" Visibility="{Binding EmptyVisibility}"/>
                                <ItemsControl ItemsSource="{Binding Cards}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Loaded="Card_Loaded" MouseEnter="Card_Enter" MouseLeave="Card_Leave" Width="150" Margin="0,0,16,16" Padding="12,12,12,12" CornerRadius="22"
                                                    Background="{DynamicResource CardBrush}" Effect="{StaticResource SoftShadow}"
                                                    Cursor="Hand" Tag="{Binding}"
                                                    MouseLeftButtonUp="RewardCard_Click">
                                                <StackPanel Opacity="{Binding CardOpacity}">
                                                    <Grid Height="126">
                                                        <Border CornerRadius="16" Background="{DynamicResource DetailsBg}"/>
                                                        <TextBlock Text="🎁" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Visibility="{Binding PlaceholderVisibility}"/>
                                                        <Image Source="{Binding Image}" Margin="6" Stretch="Uniform"
                                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        <Border Width="26" Height="26" CornerRadius="13" BorderThickness="2" BorderBrush="#9390C9"
                                                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0"
                                                                Visibility="{Binding EmptyBoxVisibility}"/>
                                                        <Border Width="26" Height="26" CornerRadius="13" Background="#6CCB8B" HorizontalAlignment="Right"
                                                                VerticalAlignment="Top" Margin="0,4,4,0" Visibility="{Binding CheckVisibility}">
                                                            <TextBlock Text="✓" Foreground="White" FontWeight="Bold" FontSize="15"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <Border CornerRadius="10" Background="#F2B84B" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                                Margin="4,0,0,4" Padding="8,1" Visibility="{Binding CountVisibility}">
                                                            <TextBlock Text="{Binding CountText}" Foreground="White" FontWeight="Bold" FontSize="13"/>
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}" FontSize="14"
                                                               FontWeight="SemiBold" Margin="2,8,0,0" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Kind}" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="2,1,0,0" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding OddsText}" Foreground="{DynamicResource TextSecondary}" FontSize="11" Margin="2,6,0,0" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding ChanceText}" Foreground="{DynamicResource TextPrimary}" FontSize="12" FontWeight="SemiBold" Margin="2,2,0,0" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding StateText}" Foreground="{DynamicResource AccentText}" FontSize="11" Margin="2,6,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="OtherTitle" Text="{local:L Fr='Autres trouvailles', En='Other finds', Es='Otros hallazgos'}" Foreground="{DynamicResource TextPrimary}" FontSize="16"
                           FontWeight="SemiBold" Margin="2,6,0,8" Visibility="Collapsed"/>
                <ItemsControl x:Name="OtherList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource RowBrush}" CornerRadius="14" Padding="16,9" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Kind}" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding CountText}" Foreground="{DynamicResource AccentText}" FontSize="15"
                                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Margin="2,16,0,0" Foreground="{DynamicResource TextMuted}" FontSize="11" TextWrapping="Wrap"
                           Text="{local:L Fr='Données et récompenses de la chasse au trésor : catalogue de ChestCounter par LED-N (licence MIT). Les images appartiennent à leurs propriétaires et sont téléchargées à la demande.', En='Treasure hunt data and rewards: ChestCounter catalogue by LED-N (MIT licence). Images belong to their owners and are downloaded on demand.', Es='Datos y recompensas de la búsqueda del tesoro: catálogo de ChestCounter de LED-N (licencia MIT). Las imágenes pertenecen a sus propietarios y se descargan bajo demanda.'}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ================= Mon compte ================= -->
        <ScrollViewer x:Name="AccountScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="{local:L Fr='Mon compte', En='My account', Es='Mi cuenta'}" Foreground="{DynamicResource AccentText}" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Foreground="{DynamicResource TextMuted}" FontSize="13" Margin="2,2,0,16" TextWrapping="Wrap"
                           Text="{local:L Fr='Stats à vie de votre compte, via l\'API fortnite-api.com. Aucun mot de passe Epic n\'est demandé ; vos stats de jeu doivent être publiques dans Fortnite.', En='Lifetime stats of your account, through the fortnite-api.com API. No Epic password is asked; your game stats must be public in Fortnite.', Es='Estadísticas de tu cuenta de por vida, mediante la API fortnite-api.com. No se pide ninguna contraseña de Epic; tus estadísticas de juego deben ser públicas en Fortnite.'}"/>
                <Border Background="{DynamicResource CardBrush}" CornerRadius="24" Padding="24,20" Effect="{StaticResource SoftShadow}" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="{local:L Fr='Pseudo Epic Games', En='Epic Games username', Es='Nombre de Epic Games'}" Foreground="{DynamicResource TextSecondary}" FontSize="13" FontWeight="SemiBold"/>
                        <TextBox x:Name="EpicNameBox" Margin="0,6,0,14" Padding="10,8" FontSize="15" Background="{DynamicResource DetailsBg}"
                                 Foreground="{DynamicResource DetailsFg}" BorderThickness="0"/>
                        <TextBlock Text="{local:L Fr='Clé API (dash.fortnite-api.com/account)', En='API key (dash.fortnite-api.com/account)', Es='Clave API (dash.fortnite-api.com/account)'}" Foreground="{DynamicResource TextSecondary}" FontSize="13" FontWeight="SemiBold"/>
                        <PasswordBox x:Name="ApiKeyBox" Margin="0,6,0,16" Padding="10,8" FontSize="15" Background="{DynamicResource DetailsBg}"
                                     Foreground="{DynamicResource DetailsFg}" BorderThickness="0"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="AccountLoadButton" Content="{local:L Fr='Charger mes stats', En='Load my stats', Es='Cargar mis estadísticas'}" Style="{StaticResource SoftButton}"
                                    Background="{StaticResource StartBrush}" FontSize="14" Padding="24,9" Click="AccountLoad_Click"/>
                            <TextBlock x:Name="AccountStatus" Foreground="{DynamicResource TextSecondary}" FontSize="13" VerticalAlignment="Center"
                                       Margin="16,0,0,0" TextWrapping="Wrap" MaxWidth="480"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="AccountHeader" Foreground="{DynamicResource TextPrimary}" FontSize="18" FontWeight="SemiBold" Margin="2,0,0,10"
                           Visibility="Collapsed"/>
                <StackPanel x:Name="ModeBar" Orientation="Horizontal" Margin="0,0,0,14" Visibility="Collapsed"/>
                <ItemsControl x:Name="AccountStats">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Loaded="Card_Loaded" MouseEnter="Card_Enter" MouseLeave="Card_Leave" Width="214" Margin="0,0,18,18" Padding="20,16,16,14" CornerRadius="24"
                                    Background="{DynamicResource CardBrush}" Effect="{StaticResource SoftShadow}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="40" Height="40" CornerRadius="20" Background="{Binding Tint, FallbackValue=#33F2B84B}">
                                            <Image Source="{Binding Key, Converter={StaticResource IconConv}}" Width="22" Height="22"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextSecondary}" FontSize="15"
                                                   FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" MaxWidth="130"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Value}" Foreground="{DynamicResource TextPrimary}" FontSize="36"
                                               FontWeight="SemiBold" Margin="2,8,0,0"/>
                                    <TextBlock Text="{Binding Sub}" Foreground="{DynamicResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Margin="2,6,0,0" Foreground="{DynamicResource TextMuted}" FontSize="11" TextWrapping="Wrap"
                           Text="{local:L Fr='Le pseudo et la clé sont enregistrés sur votre PC (%APPDATA%\\FortniteStats\\settings.json), jamais envoyés ailleurs qu\'à fortnite-api.com.', En='The username and key are saved on your PC (%APPDATA%\\FortniteStats\\settings.json) and only ever sent to fortnite-api.com.', Es='El nombre y la clave se guardan en tu PC (%APPDATA%\\FortniteStats\\settings.json) y solo se envían a fortnite-api.com.'}"/>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="GamesScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">

                <!-- Titre de la partie + bouton d'analyse -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SessionTitle" Text="{local:L Fr='Dernière partie', En='Last game', Es='Última partida'}" Foreground="{DynamicResource AccentText}"
                               FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button x:Name="AnalyzeButton" Grid.Column="1" Content="{local:L Fr='Analyser', En='Analyse', Es='Analizar'}" Style="{StaticResource SoftButton}"
                            Background="{DynamicResource SecBtnBg}" Foreground="{DynamicResource AccentText}" FontSize="14" Padding="22,8" Click="AnalyzeButton_Click"/>
                </Grid>

                <TextBlock x:Name="EmptyText" Foreground="{DynamicResource TextSecondary}" FontSize="15" Margin="2,18,0,18" TextWrapping="Wrap"
                           Text="{local:L Fr='Aucune partie analysée pour le moment. Cliquez sur « Lancer », jouez une partie jusqu\'au bout : les stats apparaîtront ici dès qu\'elle est terminée.', En='No game analysed yet. Click “Start”, play a game to the end: the stats will appear here as soon as it is over.', Es='Ninguna partida analizada por ahora. Haz clic en «Iniciar» y juega una partida hasta el final: las estadísticas aparecerán aquí en cuanto termine.'}"/>

                <!-- Bloc principal : total fouillé + répartition -->
                <Border x:Name="HeroPanel" Loaded="Card_Loaded" Background="{DynamicResource CardBrush}" CornerRadius="28" Padding="34,28,34,26"
                        Margin="0,16,0,24" Effect="{StaticResource SoftShadow}" Visibility="Collapsed">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="42" Height="42" CornerRadius="21" Background="#33F2B84B" Margin="0,0,12,0">
                                        <Image x:Name="HeroIcon" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>
                                    <TextBlock Text="{local:L Fr='Total fouillé', En='Total searched', Es='Total buscado'}" Foreground="{DynamicResource TextSecondary}" FontSize="20" FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="HeroTotal" Text="0" Foreground="{DynamicResource TextPrimary}" FontSize="96" FontWeight="SemiBold"
                                           Margin="0,-6,0,-2"/>
                                <TextBlock Text="{local:L Fr='coffres + munitions + autres', En='chests + ammo + others', Es='cofres + munición + otros'}" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="340">
                        <Grid Margin="0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="42" Height="42" CornerRadius="21" Background="#33F2B84B" Margin="0,0,14,0">
                                <Image x:Name="IcoChests" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{local:L Fr='Coffres', En='Chests', Es='Cofres'}" Foreground="{DynamicResource TextPrimary}" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock Text="{local:L Fr='coffres ouverts', En='chests opened', Es='cofres abiertos'}" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                            </StackPanel>
                            <TextBlock x:Name="HeroChests" Grid.Column="2" Text="0" Foreground="{DynamicResource TextPrimary}" FontSize="32"
                                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="28,0,0,0"/>
                        </Grid>
                        <Grid Margin="0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="42" Height="42" CornerRadius="21" Background="#335AA9F0" Margin="0,0,14,0">
                                <Image x:Name="IcoAmmo" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{local:L Fr='Munitions', En='Ammo', Es='Munición'}" Foreground="{DynamicResource TextPrimary}" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock Text="{local:L Fr='caisses de munitions', En='ammo boxes', Es='cajas de munición'}" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                            </StackPanel>
                            <TextBlock x:Name="HeroAmmo" Grid.Column="2" Text="0" Foreground="{DynamicResource TextPrimary}" FontSize="32"
                                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="28,0,0,0"/>
                        </Grid>
                        <Grid Margin="0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="42" Height="42" CornerRadius="21" Background="#339B7BFF" Margin="0,0,14,0">
                                <Image x:Name="IcoOther" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{local:L Fr='Autres', En='Others', Es='Otros'}" Foreground="{DynamicResource TextPrimary}" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock Text="{local:L Fr='autres conteneurs', En='other containers', Es='otros contenedores'}" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                            </StackPanel>
                            <TextBlock x:Name="HeroOther" Grid.Column="2" Text="0" Foreground="{DynamicResource TextPrimary}" FontSize="32"
                                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="28,0,0,0"/>
                        </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- Barre de répartition -->
                        <Grid x:Name="HeroBar" Height="10" Margin="0,22,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#F2B84B" CornerRadius="5" Margin="0,0,3,0"/>
                            <Border Grid.Column="1" Background="#5AA9F0" CornerRadius="5" Margin="0,0,3,0"/>
                            <Border Grid.Column="2" Background="#9B7BFF" CornerRadius="5"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Cumul de toutes les parties suivies -->
                <Border x:Name="CumulPanel" Loaded="Card_Loaded" Background="{DynamicResource CardBrush}" CornerRadius="24" Padding="26,18,30,18"
                        Margin="0,0,0,22" Effect="{StaticResource SoftShadow}" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="54" Height="54" CornerRadius="27" Background="#33F2B84B" Margin="0,0,18,0">
                            <Image x:Name="IcoCumul" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{local:L Fr='Coffres cumulés', En='Total chests', Es='Cofres acumulados'}" Foreground="{DynamicResource TextPrimary}" FontSize="19" FontWeight="SemiBold"/>
                            <TextBlock x:Name="CumulDetail" Foreground="{DynamicResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock x:Name="CumulChests" Grid.Column="2" Text="0" Foreground="{DynamicResource TextPrimary}" FontSize="52"
                                   FontWeight="SemiBold" VerticalAlignment="Center" Margin="24,-4,0,-4"/>
                    </Grid>
                </Border>

                <!-- Tuiles : classement, éliminations, durée... -->
                <ItemsControl x:Name="StatsList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Loaded="Card_Loaded" MouseEnter="Card_Enter" MouseLeave="Card_Leave" Width="214" Margin="0,0,18,18" Padding="20,18,16,16" CornerRadius="24"
                                    Background="{DynamicResource CardBrush}" Effect="{StaticResource SoftShadow}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="40" Height="40" CornerRadius="20" Background="{Binding Tint, FallbackValue=#33F2B84B}">
                                            <Image Source="{Binding Key, Converter={StaticResource IconConv}}" Width="22" Height="22"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Border>
                                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextSecondary}" FontSize="15" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" MaxWidth="130"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Value}" Foreground="{DynamicResource TextPrimary}" FontSize="42" FontWeight="SemiBold"
                                               Margin="2,8,0,0"/>
                                    <TextBlock Text="{Binding Sub}" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="3,0,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Historique -->
                <TextBlock Text="{local:L Fr='Dernières parties', En='Recent games', Es='Últimas partidas'}" Foreground="{DynamicResource TextPrimary}" FontSize="20" FontWeight="SemiBold" Margin="2,10,0,10"/>
                <ListBox x:Name="HistoryList" Background="Transparent" BorderThickness="0" MaxHeight="250"
                         ItemContainerStyle="{StaticResource HistoryItem}" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="HistoryList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding DateText}" Foreground="{DynamicResource TextPrimary}" FontSize="16"/>
                                <TextBlock Grid.Column="1" Text="{Binding Summary}" Foreground="{DynamicResource AccentText}" FontSize="16" FontWeight="SemiBold"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Expander Header="{local:L Fr='Tout ce qui a été lu dans la rediffusion', En='Everything read from the replay', Es='Todo lo leído en la repetición'}" Foreground="{DynamicResource TextSecondary}" Margin="2,20,0,0">
                    <TextBox x:Name="DetailsBox" IsReadOnly="True" Background="{DynamicResource DetailsBg}" Foreground="{DynamicResource DetailsFg}"
                             BorderThickness="0" FontFamily="Consolas" FontSize="12" Height="240" Margin="0,10,0,0" Padding="10"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                </Expander>

                <TextBlock Margin="2,20,0,0" Foreground="{DynamicResource TextMuted}" FontSize="11" TextWrapping="Wrap"
                           Text="{local:L Fr='Analyse des rediffusions : moteur de ChestCounter par LED-N (licence MIT), basé sur FortniteReplayDecompressor. Icônes dessinées pour cette application ; vous pouvez les remplacer par les vôtres dans le dossier « icones ».', En='Replay analysis: ChestCounter engine by LED-N (MIT licence), based on FortniteReplayDecompressor. Icons drawn for this application; you can replace them with your own in the “icones” folder.', Es='Análisis de repeticiones: motor de ChestCounter de LED-N (licencia MIT), basado en FortniteReplayDecompressor. Iconos dibujados para esta aplicación; puedes sustituirlos por los tuyos en la carpeta «icones».'}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
